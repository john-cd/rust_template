{
  // Keep the editor environment independent from the production service configuration.
  "name": "Rust workspace",
  "dockerComposeFile": "compose.devcontainer.yaml",
  "service": "devcontainer",
  // Must match the checkout mount target in compose.devcontainer.yaml and .devcontainer/.env.
  "workspaceFolder": "/workspaces/{{project-name}}",
  "shutdownAction": "stopCompose",
  "forwardPorts": [1111],
  // Keep editor recommendations and settings local to this container definition.
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "dprint.dprint",
        "EditorConfig.EditorConfig",
        "alefragnani.Bookmarks",
        "fill-labs.dependi",
        "codezombiech.gitignore",
        "UtsavVaria.goog-search",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.check.command": "clippy",
        "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
        "[markdown][json][jsonc][toml][yaml]": { "editor.defaultFormatter": "dprint.dprint" }
      }
    }
  },
  "remoteUser": "vscode"
}
