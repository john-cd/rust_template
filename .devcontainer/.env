# Shared non-secret Compose and Dockerfile build inputs.
# Credentials belong in ignored .devcontainer/.env.local; keep this shared env file non-secret.
# TODO Reviewed ??-??-????

# Keep the Compose project prefix aligned with devcontainer.json's workspace folder.
# Production builds use the CLI package name as the executable filename.
COMPOSE_PROJECT_NAME=rust-template
CARGO_PACKAGE_NAME=my_cli

# Shared devcontainer tool versions and base image series. No values here are secrets.
RUST_VERSION=1.99.1
DEBIAN_VERSION=trixie
CARGO_CHEF_VERSION=0.1.77
RUSTFMT_VERSION=nightly-2026-11-06
CARGO_MAKE_VERSION=0.37.24
CARGO_BINSTALL_VERSION=1.26.2
CARGO_NEXTEST_VERSION=0.9.148
CARGO_DENY_VERSION=0.20.2
CARGO_MACHETE_VERSION=0.9.2
CARGO_LLVM_COV_VERSION=0.9.1
ZIZMOR_VERSION=1.32.0
SCCACHE_VERSION=0.19.0
DPRINT_VERSION=0.64.3
LYCHEE_VERSION=0.24.2
ZOLA_VERSION=0.23.6
TYPOS_VERSION=1.52.0
RUSTFMT_TOOLCHAIN=1.99.1
