{
  "version": "2.0.0",
  // Route common editor actions through the repository's Cargo Make tasks.
  "tasks": [
    {
      "label": "Rust: check",
      "type": "process",
      "command": "cargo",
      "args": ["make", "check"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Rust: tests",
      "type": "process",
      "command": "cargo",
      "args": ["make", "test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Repository: format",
      "type": "process",
      "command": "cargo",
      "args": ["make", "format"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
