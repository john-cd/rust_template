# Command-line application crate; shared package metadata and lints come from the workspace.
[package]
name = "{{project-name}}"
version.workspace = true
categories = ["command-line-utilities"]
edition.workspace = true
keywords.workspace = true
license.workspace = true
publish.workspace = true
readme = "README.md"
rust-version.workspace = true
description = "Starter command-line application for a Rust workspace"

[lib]
name = "{{crate_name}}"

# Clap parses arguments, while my_lib provides reusable behavior.
[dependencies]
clap.workspace = true
{{crate_name}}_lib.workspace = true

[lints]
workspace = true
