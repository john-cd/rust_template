# Command-line application crate; shared package metadata and lints come from the workspace.
[package]
# Generated Cargo package name; the crate folder can be customized independently.
name = "{{cli_package_name}}"
# Inherit release and compiler policy from the root; command-line crates add their own category.
version.workspace = true
categories = ["command-line-utilities"]
# Inherit language edition, discovery keywords, license, publish policy, and MSRV from the root.
edition.workspace = true
keywords.workspace = true
license.workspace = true
publish.workspace = true
# Use this crate's README as its package description page.
readme = "README.md"
rust-version.workspace = true
description = "Starter command-line application for a Rust workspace"

[lib]
# Keep the Rust crate identifier valid when the generated package name contains hyphens.
name = "{{cli_package_name | replace: "-", "_"}}"

# Clap parses arguments, the generated library provides reusable behavior, and tracing emits diagnostics.
[dependencies]
clap.workspace = true
"{{lib_package_name | replace: "-", "_"}}".workspace = true
tracing.workspace = true
tracing-appender.workspace = true
tracing-subscriber.workspace = true

[lints]
# Apply the workspace's Rust, rustdoc, and Clippy rules to this crate.
workspace = true
